function cfg = makeStageConfig()

%% =========================================================
% MODEL / TRAINING SETUP
% =========================================================

cfg.ModelName = "rlwatertank";
cfg.AgentBlock = "rlwatertank/RL Agent";

cfg.Ts = 0.1;
cfg.Tf = 10;

%cfg.UseParallel = false;
cfg.UseParallel = true;
cfg.RequestedWorkers = 16;

cfg.Verbose = true;
cfg.PlotMode = "training-progress";

cfg.SavePrefix = "WaterTankDDPG_curriculum";
cfg.FinalSaveName = "WaterTankDDPG_curriculum_final.mat";

cfg.SaveReplayBuffer = false;
cfg.SaveTrainingStats = true;

%% =========================================================
% SHARED REWARD DEFAULTS
% =========================================================
% Research-aligned reward structure:
%
%   r_total = r_base + w_shape * (gamma*Phi(s') - Phi(s))
%
% where:
%
%   r_base =
%       - w_e * (e/e_scale)^2
%       - w_I * (I_e/I_scale)^2
%       - lambda_u * u^2
%       - lambda_du * (u - u_prev)^2
%       - unsafePenalty * 1_unsafe
%
% The same base control objective is used in every stage.
% Curriculum difficulty is changed through the reset distribution,
% exploration noise, and potential-shaping weight.
%
% Important:
% Do NOT change e_scale from stage to stage just to make learning easier.
% That changes the meaning of the reward. Instead, keep the final control
% objective consistent and make the task easier/harder through the reset
% distribution.

baseReward.mode = 4;                  % mode 4 = research-aligned base reward + optional potential shaping

% Threshold reward parameters
% These are mainly used by mode 1, but are retained so the same reward
% parameter structure can support all reward modes.
baseReward.thr = 0.1;                 % threshold for simple success reward
baseReward.posReward = 10;            % reward when abs(error) is inside threshold
baseReward.negReward = -1;            % reward when abs(error) is outside threshold

% Safety limits
baseReward.unsafePenalty = 100;       % terminal penalty for unsafe tank height
baseReward.h_min = 0;                 % minimum allowed tank height
baseReward.h_max = 20;                % maximum allowed tank height

% Control penalties
baseReward.lambda_u = 0.001;          % control effort penalty weight
baseReward.lambda_du = 0.02;          % control smoothness penalty weight
baseReward.duWarmupSteps = 2;         % skip artificial startup delta-u penalties

% Base tracking objective
baseReward.e_scale = 1.0;             % fixed error scale used in all stages

% Hard tolerance bonus
% For the research-aligned reward, this should be zero or very small.
% A hard tolerance bonus introduces a discontinuity and can teach the agent
% that being barely inside the tolerance band is "good enough."
baseReward.tol = 0.02;                % tolerance band for optional bonus
baseReward.tolBonus = 0;              % optional bonus inside tolerance band

% Base tracking and integral-error objective
baseReward.w_e = 1.0;                 % weight on normalized squared tracking error

% Integral-error penalty
% This is the PI-like part of the reward. It penalizes persistent error and
% directly targets low steady-state error.
baseReward.w_I = 0.05;                % weight on normalized squared integral error
baseReward.I_scale = 5.0;             % scale for integral error normalization

% Optional exponential tracking reward
% Disabled initially. The default tracking term is quadratic.
% If enabled, the exponential term replaces the quadratic tracking term.
baseReward.useExpTrack = false;
baseReward.sigma_e = 0.2;
baseReward.w_track = 1.0;

% Potential-based shaping
% This adds:
%
%   w_shape * (gamma*Phi(s') - Phi(s))
%
% with:
%
%   Phi(s) = -k_phi_e*(e/e_scale)^2 - k_phi_I*(I_e/I_scale)^2
%
% Shaping helps learning but should be reduced over stages.
baseReward.usePotentialShaping = true;
baseReward.shapingWeight = 1.0;       % weight applied to potential-based shaping term
baseReward.gamma = 0.99;
baseReward.k_phi_e = 1.0;
baseReward.k_phi_I = 0.05;

%%
% All stages use the same final base reward objective.
% The curriculum changes only:
%   1) reset distribution / task difficulty
%   2) potential-shaping weight
%   3) exploration noise
%   4) optional final smoothness emphasis
%
% Therefore the stage names describe training conditions,
% not different reward objectives.

%% =========================================================
% STAGE 1: LOCAL CORRECTION
% =========================================================
% Purpose:
% Learn basic local correction with small-to-medium initial errors.
% Uses strong potential-based shaping to guide the agent toward the target.

stages(1).Name = "easy_reset_strong_shaping";
stages(1).Seed = 1;
stages(1).MaxEpisodes = 800;

stages(1).EvaluationFrequency = 25;
stages(1).EvaluationEpisodes = 3;     % kept for compatibility; custom evaluator may ignore this

stages(1).StopTrainingCriteria = "EpisodeCount";
stages(1).StopTrainingValue = stages(1).MaxEpisodes;

stages(1).Reset.mode = "offset";
stages(1).Reset.hRefMean = 10;
stages(1).Reset.hRefStd = 3;
stages(1).Reset.hMin = 0;
stages(1).Reset.hMax = 20;
stages(1).Reset.minInitialError = 0.5;
stages(1).Reset.maxInitialError = 2.0;

stages(1).Reward = baseReward;
stages(1).Reward.shapingWeight = 1.0;

stages(1).NoiseStd = 0.05;
stages(1).NoiseDecay = 1e-5;

% Reset buffer because reward includes shaping, and shaping weight changes
% between stages.
stages(1).ResetBuffer = true;

%% =========================================================
% STAGE 2: MEDIUM TRANSIENTS
% =========================================================
% Purpose:
% Increase initial-error difficulty while keeping the same base objective.
% Shaping is reduced so the policy relies more on the true base reward.

stages(2) = stages(1);
stages(2).Name = "medium_reset_medium_shaping";
stages(2).Seed = 2;
stages(2).MaxEpisodes = 1000;
stages(2).StopTrainingValue = stages(2).MaxEpisodes;

stages(2).Reset.maxInitialError = 5.0;

stages(2).Reward = baseReward;
stages(2).Reward.shapingWeight = 0.5;

stages(2).NoiseStd = 0.08;
stages(2).NoiseDecay = 1e-5;
stages(2).ResetBuffer = true;

%% =========================================================
% STAGE 3: GLOBAL ROBUSTNESS
% =========================================================
% Purpose:
% Train on the full operating range.
% The reward objective is still the same; only the reset distribution is
% broader. Shaping is weak.

stages(3) = stages(1);
stages(3).Name = "full_reset_weak_shaping";
stages(3).Seed = 3;
stages(3).MaxEpisodes = 1500;
stages(3).StopTrainingValue = stages(3).MaxEpisodes;

stages(3).Reset.mode = "independent";

stages(3).Reward = baseReward;
stages(3).Reward.shapingWeight = 0.2;

stages(3).NoiseStd = 0.12;
stages(3).NoiseDecay = 1e-5;
stages(3).ResetBuffer = true;

%% =========================================================
% STAGE 4: PRECISION FINE-TUNING
% =========================================================
% Purpose:
% Fine-tune the controller using the true base reward with no potential
% shaping. This makes the final policy optimize the actual control
% objective directly.
%
% This stage should expose the agent both to full-range initial conditions
% and near-reference cases if your reset function supports that.

stages(4) = stages(1);
stages(4).Name = "full_reset_no_shaping_low_noise";
stages(4).Seed = 4;
stages(4).MaxEpisodes = 1000;
stages(4).StopTrainingValue = stages(4).MaxEpisodes;

stages(4).Reset.mode = "independent";

stages(4).Reward = baseReward;
stages(4).Reward.shapingWeight = 0.0;

% Slightly stronger smoothness penalty during precision fine-tuning.
% This is not a different reward philosophy; it only tightens final control
% behavior. If this hurts steady-state accuracy, reduce it back to 0.02.
stages(4).Reward.lambda_du = 0.05;

stages(4).NoiseStd = 0.02;
stages(4).NoiseDecay = 1e-5;
stages(4).ResetBuffer = true;

cfg.Stages = stages;

end

%% =========================================================
% NOTES ON REWARD FIELDS
% =========================================================
%
% baseReward.mode
%   1 = original threshold reward
%   2 = normalized quadratic error only
%   3 = older shaped reward:
%       quadratic error + control penalties + optional tolerance bonus
%   4 = research-aligned reward:
%       base control objective + optional potential-based shaping
%
% baseReward.w_e
%   Weight on normalized squared tracking error:
%       (e/e_scale)^2
%
% baseReward.e_scale
%   Error normalization scale.
%   In the research-aligned curriculum, this should stay fixed across
%   stages so the meaning of the reward does not change.
%
% baseReward.w_I
%   Weight on normalized squared integral error:
%       (I_e/I_scale)^2
%   This term penalizes persistent error and is important for reducing
%   steady-state offset.
%
% baseReward.I_scale
%   Integral-error normalization scale.
%
% baseReward.lambda_u
%   Penalty weight on control effort:
%       u^2
%
% baseReward.lambda_du
%   Penalty weight on control smoothness:
%       (u - u_prev)^2
%
% baseReward.duWarmupSteps
%   Number of initial reward calls for which the delta-u penalty is disabled.
%   This avoids punishing artificial jumps caused by delay initial conditions.
%
% baseReward.tolBonus
%   Optional hard tolerance bonus.
%   Recommended value for the research-aligned reward: 0.
%
% baseReward.usePotentialShaping
%   Enables potential-based shaping:
%       gamma*Phi(s') - Phi(s)
%
% baseReward.shapingWeight
%   Stage-dependent multiplier on the potential-based shaping term.
%   Recommended curriculum:
%       Stage 1: 1.0
%       Stage 2: 0.5
%       Stage 3: 0.2
%       Stage 4: 0.0
%
% baseReward.gamma
%   Discount factor used inside the potential-based shaping term.
%   Ideally this should match the agent discount factor.
%
% baseReward.k_phi_e, baseReward.k_phi_I
%   Weights inside the potential function:
%       Phi(s) = -k_phi_e*(e/e_scale)^2 - k_phi_I*(I_e/I_scale)^2
%
% baseReward.unsafePenalty
%   Terminal safety penalty:
%       -unsafePenalty * 1_unsafe
%   This is intentionally kept even though it is discontinuous, because
%   unsafe tank heights represent hard constraints rather than soft
%   tracking preferences.