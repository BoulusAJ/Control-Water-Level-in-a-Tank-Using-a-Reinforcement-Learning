clear; clc;

previousRngState = rng(0,"twister");

cfg = makeStageConfig();

mdl = cfg.ModelName;
open_system(mdl);

set_param(mdl, ...
    FastRestart="on", ...
    SimulationMode="accelerator");

%% Environment
obsInfo = rlNumericSpec([3 1], ...
    LowerLimit=[-inf -inf 0]', ...
    UpperLimit=[ inf  inf inf]');

obsInfo.Name = "observations";
obsInfo.Description = "Observation vector: [I_e; e; h]";

actInfo = rlNumericSpec([1 1], ...
    LowerLimit=0, ...
    UpperLimit=1);

actInfo.Name = "flow";

env = rlSimulinkEnv( ...
    mdl, ...
    cfg.AgentBlock, ...
    obsInfo, ...
    actInfo);

env.ResetFcn = @localResetFcnCurriculum;

%% Agent
agent = createDDPGAgent(obsInfo, actInfo, cfg);

%% Evaluation setup
evalCfg = makeWaterTankEvalConfig(cfg);

evalLog = struct();
evalLog.runStartedAt = datetime("now");
evalLog.trainingValidation = [];
evalLog.postStage = [];
evalLog.final = [];

%% Parallel pool
if cfg.UseParallel
    pool = gcp("nocreate");
    if isempty(pool)
        pool = parpool("Processes", cfg.RequestedWorkers);
    elseif pool.NumWorkers ~= cfg.RequestedWorkers
        delete(pool);
        pool = parpool("Processes", cfg.RequestedWorkers);
    end
end

%% Curriculum loop
%for k = 1:numel(cfg.Stages)
 for k = 1:1

    stage = cfg.Stages(k);

    fprintf("\n=====================================\n");
    fprintf("Starting Stage %d: %s\n", k, stage.Name);
    fprintf("=====================================\n");

    assignin("base","curriculumParams",stage.Reset);
    assignin("base","rewardParams",stage.Reward);

    agent = configureAgentForStage(agent, stage);

    trainOpts = rlTrainingOptions( ...
        MaxEpisodes=stage.MaxEpisodes, ...
        MaxStepsPerEpisode=ceil(cfg.Tf/cfg.Ts), ...
        Verbose=cfg.Verbose, ...
        Plots=cfg.PlotMode, ...
        StopTrainingCriteria=stage.StopTrainingCriteria, ...
        StopTrainingValue=stage.StopTrainingValue, ...
        UseParallel=cfg.UseParallel);

    if cfg.UseParallel
        trainOpts.ParallelizationOptions.Mode = "async";
        trainOpts.ParallelizationOptions.DataToSendFromWorkers = "experiences";
        trainOpts.ParallelizationOptions.StepsUntilDataIsSent = 32;
    end

    %% Custom training-time evaluator
    % Uses a small fixed validation set every EvaluationFrequency episodes.
    % It returns one gated scalar score to train(), but also logs the full
    % metric table in the evaluator data.

    if useCustomEvaluatorDuringTraining
        evl = rlCustomEvaluator( ...
            @(agentIn, envIn, trainInfo) waterTankTrainingEvaluator( ...
            agentIn, envIn, trainInfo, evalCfg, stage, k), ...
            EvaluationFrequency=stage.EvaluationFrequency);
        rng(stage.Seed,"twister");
        trainingStats = train(agent, env, trainOpts, Evaluator=evl);
    else useMATLABEvaluator
        trainingStats = train(agent, env, trainOpts);
    end
    
    %% Post-stage full evaluation
    fprintf("\nRunning post-stage evaluation for Stage %d: %s\n", k, stage.Name);

    postStageEval = evaluateWaterTankController( ...
        agent, env, evalCfg.FinalCases, evalCfg, ...
        "ControllerName", "DDPG", ...
        "EvalSetName", "post_stage_full", ...
        "StageIndex", k, ...
        "StageName", stage.Name);

    evalLog.postStage = [evalLog.postStage; postStageEval.summary];

    %% Save stage result
    saveName = sprintf("%s_stage_%02d_%s.mat", ...
        cfg.SavePrefix, k, stage.Name);

    if cfg.SaveReplayBuffer
        agent.AgentOptions.SaveExperienceBufferWithAgent = true;
    else
        agent.AgentOptions.SaveExperienceBufferWithAgent = false;
    end

    if cfg.SaveTrainingStats
        save(saveName, ...
            "agent", ...
            "trainingStats", ...
            "stage", ...
            "postStageEval", ...
            "evalCfg");
    else
        save(saveName, ...
            "agent", ...
            "stage", ...
            "postStageEval", ...
            "evalCfg");
    end

    fprintf("Saved %s\n", saveName);

end

%% Final validation
fprintf("\nRunning final full evaluation...\n");

finalEval = evaluateWaterTankController( ...
    agent, env, evalCfg.FinalCases, evalCfg, ...
    "ControllerName", "DDPG", ...
    "EvalSetName", "final_full", ...
    "StageIndex", numel(cfg.Stages), ...
    "StageName", "final");

evalLog.final = finalEval.summary;
evalLog.runFinishedAt = datetime("now");

save(cfg.FinalSaveName, ...
    "agent", ...
    "cfg", ...
    "evalCfg", ...
    "evalLog", ...
    "finalEval");

set_param(mdl, FastRestart="off");
rng(previousRngState);