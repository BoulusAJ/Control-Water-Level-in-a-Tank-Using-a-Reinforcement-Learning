function [r, isDone] = rewardFcn(e, I_e, e_prev, I_e_prev, ...
    u, u_prev, h, stepCount, params)

% rewardFcn
%
% Reward function for RL-based level control.
%
% The reward structure and all parameter values are configured externally
% in makeStageConfig.m (rewardParams) before simulation starts.
% This function assumes every required field already exists in params.
%
% Modes:
%
% 1: threshold reward
% 2: normalized quadratic error reward
% 3: previous shaped reward:
%    error + effort + delta-u + optional tolerance bonus
% 4: research-aligned base reward with optional
%    potential-based shaping
%
% Mode 4:
%
% r_total = r_base + w_shape * (gamma * Phi(s') - Phi(s))
%
% r_base =
%   - w_e      * (e/e_scale)^2
%   - w_I      * (I_e/I_scale)^2
%   - lambda_u * u^2
%   - lambda_du * (u - u_prev)^2
%   - unsafePenalty * 1_unsafe
%
% Phi(s) =
%   - k_phi_e * (e/e_scale)^2
%   - k_phi_I * (I_e/I_scale)^2

%% Safety termination

isDone = (h <= params.h_min) || (h >= params.h_max);

%% Reward modes

switch params.mode

    case 1

        % ------------------------------------------------------------
        % Simple threshold reward
        % ------------------------------------------------------------

        if abs(e) < params.thr
            r = params.posReward;
        else
            r = params.negReward;
        end

    case 2

        % ------------------------------------------------------------
        % Normalized quadratic error reward
        % ------------------------------------------------------------

        eNorm = e / params.e_scale;

        r = -(eNorm.^2);

    case 3

        % ------------------------------------------------------------
        % Previous shaped reward
        % ------------------------------------------------------------

        if stepCount <= params.duWarmupSteps
            duPenalty = 0;
        else
            duPenalty = params.lambda_du * ((u - u_prev).^2);
        end

        eNorm = e / params.e_scale;

        r = -(eNorm.^2) ...
            - params.lambda_u * (u.^2) ...
            - duPenalty;

        if params.tolBonus ~= 0 && abs(e) < params.tol
            r = r + params.tolBonus;
        end

    case 4

        % ------------------------------------------------------------
        % Research-aligned base control objective
        % with optional potential-based shaping
        % ------------------------------------------------------------

        %% Delta-u penalty with startup warmup
        %
        % With delayed actions:
        %
        % u      = u_{k-1}
        % u_prev = u_{k-2}
        %
        % The first one or two delta-u values can be artificial because
        % delay initial conditions are usually zero.

        if stepCount <= params.duWarmupSteps
            duPenalty = 0;
        else
            duPenalty = params.lambda_du * ((u - u_prev).^2);
        end

        %% Tracking term

        if params.useExpTrack

            % Smooth bounded peak around zero error.
            %
            % At e = 0:
            %
            %   exp(0) - 1 = 0
            %
            % For large |e|:
            %
            %   exp(-large) - 1 -> -1
            %
            % This avoids huge transient errors dominating the reward,
            % but can weaken gradients far from the target.

            trackReward = params.w_track * ...
                (exp(-((e / params.sigma_e).^2)) - 1);

        else

            % Standard normalized quadratic tracking penalty

            trackReward = ...
                -params.w_e * ((e / params.e_scale).^2);

        end

        %% Integral-error penalty
        %
        % This is the PI-like part of the reward.
        % It penalizes persistent error and therefore directly targets
        % steady-state accuracy.

        integralPenalty = ...
            params.w_I * ((I_e / params.I_scale).^2);

        %% Control effort penalty

        effortPenalty = params.lambda_u * (u.^2);

        %% Base reward

        r_base = trackReward ...
            - integralPenalty ...
            - effortPenalty ...
            - duPenalty;

        %% Optional potential-based shaping

        if params.usePotentialShaping && ...
                params.shapingWeight ~= 0

            % Current state is interpreted as s'

            Phi_next = ...
                -params.k_phi_e * ((e / params.e_scale).^2) ...
                -params.k_phi_I * ((I_e / params.I_scale).^2);

            % Previous state is interpreted as s

            Phi_prev = ...
                -params.k_phi_e * ((e_prev / params.e_scale).^2) ...
                -params.k_phi_I * ((I_e_prev / params.I_scale).^2);

            shapingReward = ...
                params.gamma * Phi_next - Phi_prev;

        else

            shapingReward = 0;

        end

        %% Total reward before unsafe terminal penalty

        r = r_base + ...
            params.shapingWeight * shapingReward;

        %% Optional tolerance bonus
        %
        % For the research-aligned version, I recommend keeping this zero
        % or very small. It is included only for backward compatibility.

        if params.tolBonus ~= 0 && abs(e) < params.tol
            r = r + params.tolBonus;
        end

    otherwise

        error('rewardFcn:InvalidMode', ...
            'Unknown mode %d', params.mode);

end

%% Unsafe terminal penalty
%
% This is the explicit:
%
%   -w_unsafe * 1_unsafe
%
% term. It is kept outside the mode-specific reward so that every reward
% mode respects the tank safety limits.

if isDone
    r = r - params.unsafePenalty;
end

end